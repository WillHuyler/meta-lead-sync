node_modules/
.pnpm-store/
.yarn/
vendor/

# ==========================================
# Next.js / Web Application Build Outputs
# ==========================================
.next/
out/
build/
dist/

# ==========================================
# Python & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
*.venv

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ==========================================
